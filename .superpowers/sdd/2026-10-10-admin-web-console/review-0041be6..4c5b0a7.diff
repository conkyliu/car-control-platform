+      key: 'status',
+      width: 120,
+      render: (status: DigitalKeyStatus) => {
+        const meta = DIGITAL_KEY_STATUS_META[status];
+        return (
+          <Badge
+            status={meta.badgeStatus}
+            text={
+              <Tag color={meta.tagColor} style={{ marginLeft: 6 }}>
+                {meta.label}
+              </Tag>
