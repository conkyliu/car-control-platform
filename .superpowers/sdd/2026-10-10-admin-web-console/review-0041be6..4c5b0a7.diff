+          />
+        );
+      },
+    },
+    {
+      title: '操作',
+      key: 'action',
+      fixed: 'right',
+      width: 160,
+      render: (_, record) => {
+        const isRevoked = record.status === 'REVOKED';
+        const isExpired = record.status === 'EXPIRED';
+        const canRevoke = !isRevoked && !isExpired;
+
+        return (
+          <Space size="small">
+            <Button
+              type="link"
+              size="small"
+              onClick={() => {
+                setSelectedKey(record);
+                setDetailDrawerOpen(true);
+              }}
+            >
+              详情
+            </Button>
+
+            <Popconfirm
+              title="吊销作废数字钥匙"
+              description={
+                <div style={{ maxWidth: 280 }}>
+                  <Text type="danger" strong>
+                    ⚠️ 危险操作：
+                  </Text>
+                  <div>
+                    作废后将下发 CRL 吊销黑名单至车端，接收人将立即失去该车辆的近场及远程控制权限，此操作不可逆！
+                  </div>
+                </div>
+              }
+              okText="确认吊销"
+              okButtonProps={{ danger: true, loading: actionLoading }}
+              cancelText="取消"
+              disabled={!canRevoke}
+              onConfirm={() => handleRevokeKey(record)}
+            >
+              <Button
+                type="link"
+                danger
+                size="small"
+                disabled={!canRevoke}
+                title={
+                  isRevoked
+                    ? '该钥匙已作废'
+                    : isExpired
+                    ? '该钥匙已到期失效'
+                    : '吊销作废钥匙'
+                }
+              >
+                吊销作废
+              </Button>
+            </Popconfirm>
+          </Space>
+        );
+      },
+    },
+  ];
+
+  return (
+    <div style={{ maxWidth: 1600, margin: '0 auto' }}>
+      {/* 顶部标题与说明 */}
+      <Card
+        styles={{ body: { padding: '16px 20px' } }}
+        style={{
+          borderRadius: 8,
+          marginBottom: 16,
+          boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+        }}
+      >
+        <Row justify="space-between" align="middle" gutter={[16, 16]}>
+          <Col xs={24} md={14}>
+            <Space align="center" size="middle">
+              <KeyOutlined style={{ fontSize: 24, color: '#1677ff' }} />
+              <div>
+                <Title level={4} style={{ margin: 0 }}>
+                  数字钥匙授权与分享中心
+                </Title>
+                <Paragraph type="secondary" style={{ margin: 0, fontSize: 13 }}>
+                  支持 BLE 低功耗蓝牙钥匙、Cloud 云端远程钥匙与 NFC 实体卡片的全生命周期鉴权管控与 CRL 安全吊销
+                </Paragraph>
+              </div>
+            </Space>
+          </Col>
+          <Col xs={24} md={10} style={{ textAlign: 'right' }}>
+            <Space wrap>
+              <Button
+                type="primary"
+                icon={<PlusOutlined />}
+                onClick={() => {
+                  issueForm.resetFields();
+                  issueForm.setFieldsValue({
+                    vehicleId: SEED_WORKBENCH_VEHICLES[0]!.id,
+                    keyType: 'BLE',
+                    maxUsageCount: 10,
+                  });
+                  setLimitUsage(false);
+                  setIssueModalOpen(true);
+                }}
+              >
+                发放数字钥匙
+              </Button>
+              <Button icon={<ReloadOutlined />} onClick={loadKeys} loading={loading}>
