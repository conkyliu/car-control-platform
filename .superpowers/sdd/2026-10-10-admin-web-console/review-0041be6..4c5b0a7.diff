+
+        const displayed = permCodes.slice(0, 2);
+        const rest = permCodes.slice(2);
+
+        return (
+          <Space size={[4, 4]} wrap>
+            {displayed.map((c) => (
+              <Tag key={c} style={{ fontSize: 11, marginInlineEnd: 4 }}>
+                {COMMAND_METADATA[c]?.name || c}
+              </Tag>
+            ))}
+            {rest.length > 0 && (
+              <Tooltip
+                title={
+                  <div>
