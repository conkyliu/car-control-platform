+  requestPayload?: any;
+  responsePayload?: any;
+  errorMessage?: string;
+  signatureHash?: string;
+  createdAt: string;
+}
+
+export interface AuditLogQueryParams {
+  keyword?: string;
+  module?: string;
+  action?: string;
+  status?: string;
+  riskLevel?: string;
+  startTime?: string;
+  endTime?: string;
+  page?: number;
+  pageSize?: number;
+}
