+export interface AuditLogDto {
+  id: string;
+  traceId: string;
+  tenantId?: string;
+  tenantName?: string;
+  operatorId: string;
+  operatorName: string;
+  operatorUsername: string;
+  orgId?: string;
+  orgName?: string;
+  clientIp: string;
+  clientLocation?: string;
