+} from '@ant-design/icons';
+import type {
+  AuditLogDto,
+  AuditLogQueryParams,
+  AuditLogRiskLevel,
+} from '../../api/audit.ts';
+import { fetchAuditLogsApi, exportAuditLogsApi } from '../../api/audit.ts';
+import {
+  calculateAuditStats,
+  filterAuditLogs,
+  getRiskLevel,
+  AUDIT_MODULES,
+  AUDIT_ACTIONS,
+  isApiError,
+} from './audit-core.ts';
+
+const { Title, Text, Paragraph } = Typography;
+
+export const AuditLogView: React.FC = () => {
+  const [logs, setLogs] = useState<AuditLogDto[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [exporting, setExporting] = useState(false);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  // 筛选状态
+  const [keyword, setKeyword] = useState('');
+  const [selectedModule, setSelectedModule] = useState<string>('ALL');
+  const [selectedAction, setSelectedAction] = useState<string>('ALL');
+  const [selectedStatus, setSelectedStatus] = useState<string>('ALL');
+  const [selectedRisk, setSelectedRisk] = useState<string>('ALL');
+  const [datePreset, setDatePreset] = useState<'ALL' | 'TODAY' | '7D' | '30D'>('ALL');
+  const [dateRange, setDateRange] = useState<[string | undefined, string | undefined]>([
+    undefined,
+    undefined,
+  ]);
+
+  // 抽屉详情状态
+  const [detailVisible, setDetailVisible] = useState(false);
+  const [selectedLog, setSelectedLog] = useState<AuditLogDto | null>(null);
+
+  // 加载数据
+  const loadLogs = async () => {
+    setLoading(true);
+    setErrorMsg(null);
+    try {
+      const data = await fetchAuditLogsApi();
+      setLogs(data);
+    } catch (err) {
+      if (isApiError(err)) {
+        setErrorMsg(`无法拉取操作审计日志：${err.message} (HTTP ${err.statusCode})`);
+      } else {
+        setErrorMsg('当前网络通信繁忙，未能收到审计服务端应答，请稍后刷新重试');
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    loadLogs();
+  }, []);
+
+  // 快捷时间范围预设处理
+  const handlePresetDateChange = (preset: 'ALL' | 'TODAY' | '7D' | '30D') => {
+    setDatePreset(preset);
+    const now = new Date();
+    const formatDate = (d: Date) => {
+      const y = d.getFullYear();
