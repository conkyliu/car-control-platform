+/**
+ * 端到端执行耗时格式化纯函数
+ * < 1000ms: 显示 Xms
+ * ≥ 1000ms: 显示 X.XXs
+ */
+export function formatExecutionDuration(ms?: number | null): string {
+  if (ms === null || ms === undefined || ms < 0 || Number.isNaN(ms)) {
+    return '-';
+  }
+  if (ms < 1000) {
+    return `${Math.round(ms)}ms`;
+  }
+  return `${(ms / 1000).toFixed(2)}s`;
+}
