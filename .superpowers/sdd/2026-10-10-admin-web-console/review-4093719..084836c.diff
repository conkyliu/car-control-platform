+export type VoltageHealthLevel = 'NORMAL' | 'LOW' | 'CRITICAL';
+
+export interface VoltageHealthMeta {
+  level: VoltageHealthLevel;
+  text: string;
+  color: string;
+  tagColor: 'success' | 'warning' | 'error';
+}
+
+/**
+ * 蓄电池电压健康度评估
+ * ≥ 12.0V: 正常 (绿色)
+ * 11.0V ~ 11.9V: 欠压警告 (橙色)
+ * < 11.0V: 严重欠压 (红色)
+ */
+export function evaluateVoltageHealth(voltage: number): VoltageHealthMeta {
+  if (voltage >= 12.0) {
+    return {
+      level: 'NORMAL',
+      text: '正常',
+      color: '#52c41a',
+      tagColor: 'success',
+    };
+  }
+  if (voltage >= 11.0) {
+    return {
+      level: 'LOW',
+      text: '欠压告警',
+      color: '#faad14',
+      tagColor: 'warning',
+    };
+  }
+  return {
+    level: 'CRITICAL',
+    text: '严重欠压',
+    color: '#ff4d4f',
+    tagColor: 'error',
+  };
+}
