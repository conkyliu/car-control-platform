+          >
+            <Input
+              placeholder="例如: SZ_SPEED_01"
+              maxLength={20}
+              style={{ textTransform: 'uppercase', fontFamily: 'monospace' }}
+            />
+          </Form.Item>
+
+          <Form.Item name="orgName" label="归属机构名称">
+            <Input placeholder="例如: 华南智慧车联网运营部" maxLength={30} />
+          </Form.Item>
+
+          <Row gutter={16}>
