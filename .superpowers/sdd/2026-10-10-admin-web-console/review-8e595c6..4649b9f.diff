+import type { DeviceDto } from './device-core.ts';
+
+/**
+ * 项目代号格式正则表达式 (3~20 位大写字母、数字或下划线)
+ */
+export const PROJECT_CODE_REGEX = /^[A-Z0-9_]{3,20}$/;
+
+/**
+ * 校验项目英文唯一代码格式
+ */
+export function validateProjectCode(code?: string | null): boolean {
+  if (!code || typeof code !== 'string') return false;
+  return PROJECT_CODE_REGEX.test(code.trim());
+}
+
+/**
+ * 项目生命周期状态定义
+ * ACTIVE 运营中 / PAUSED 暂停 / ARCHIVED 已归档
+ */
+export type ProjectStatus = 'ACTIVE' | 'PAUSED' | 'ARCHIVED';
+
+export interface ProjectStatusMeta {
+  label: string;
+  color: string;
+  tagColor: string;
+  description: string;
+}
+
+export const PROJECT_STATUS_MAP: Record<ProjectStatus, ProjectStatusMeta> = {
+  ACTIVE: {
+    label: '运营中',
+    color: '#52c41a',
+    tagColor: 'success',
+    description: '项目正常承载车辆运营与设备数据汇聚',
+  },
+  PAUSED: {
+    label: '已暂停',
+    color: '#faad14',
+    tagColor: 'warning',
+    description: '项目暂停新增接入，存量设备保持基础通讯',
+  },
+  ARCHIVED: {
+    label: '已归档',
+    color: '#8c8c8c',
+    tagColor: 'default',
+    description: '项目已结项封存，只读归档',
+  },
+};
+
+export interface ProjectDto {
+  id: string;
+  name: string;
+  code: string;
+  orgId?: string;
+  orgName?: string;
+  contactName?: string;
+  contactPhone?: string;
+  status?: ProjectStatus;
+  deviceCount?: number;
+  vehicleCount?: number;
+  onlineDeviceCount?: number;
+  tenantId?: string;
+  description?: string;
+  createdAt?: string;
+  updatedAt?: string;
+}
+
+export interface CreateProjectInput {
+  name: string;
+  code: string;
+  orgName?: string;
+  contactName?: string;
+  contactPhone?: string;
+  description?: string;
+  status?: ProjectStatus;
+}
+
