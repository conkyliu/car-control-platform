+          </Card>
+        </Col>
+
+        <Col xs={24} sm={12} md={6}>
+          <Card
+            bordered={false}
+            style={{
+              borderRadius: 8,
+              boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+            }}
+          >
+            <Statistic
+              title="正常运营中项目"
+              value={stats.activeCount}
+              prefix={<CheckCircleOutlined style={{ color: '#52c41a' }} />}
+              valueStyle={{ color: '#52c41a' }}
+              suffix={<Text type="secondary" style={{ fontSize: 13 }}>个</Text>}
+            />
+          </Card>
+        </Col>
+
+        <Col xs={24} sm={12} md={6}>
+          <Card
+            bordered={false}
+            style={{
+              borderRadius: 8,
+              boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+            }}
+          >
+            <Statistic
+              title="已调配车载终端"
+              value={stats.totalDevices}
+              prefix={<DesktopOutlined style={{ color: '#1677ff' }} />}
+              suffix={<Text type="secondary" style={{ fontSize: 13 }}>台</Text>}
+            />
+          </Card>
+        </Col>
+
+        <Col xs={24} sm={12} md={6}>
+          <Card
+            bordered={false}
+            style={{
+              borderRadius: 8,
+              boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+            }}
+          >
+            <Statistic
+              title="关联车辆资产数"
+              value={stats.totalVehicles}
+              prefix={<CarOutlined style={{ color: '#722ed1' }} />}
+              valueStyle={{ color: '#722ed1' }}
+              suffix={<Text type="secondary" style={{ fontSize: 13 }}>辆</Text>}
+            />
+          </Card>
+        </Col>
+      </Row>
+
+      {/* 筛选与操作工具栏 */}
+      <Card
+        bordered={false}
+        style={{
+          borderRadius: 8,
+          boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+        }}
+      >
+        <Row gutter={[16, 16]} justify="space-between" align="middle">
+          <Col xs={24} lg={18}>
+            <Space wrap size="middle">
+              <Input
+                placeholder="搜索项目名称 / 项目代号 / 机构 / 负责人..."
+                prefix={<SearchOutlined style={{ color: 'rgba(0,0,0,0.45)' }} />}
+                value={keyword}
+                onChange={(e) => setKeyword(e.target.value)}
+                style={{ width: 280 }}
+                allowClear
+              />
+
+              <Select
+                value={statusFilter}
+                onChange={setStatusFilter}
+                style={{ width: 150 }}
+                options={[
+                  { label: '全部项目状态', value: 'ALL' },
+                  { label: '🟢 运营中 (ACTIVE)', value: 'ACTIVE' },
+                  { label: '🟠 已暂停 (PAUSED)', value: 'PAUSED' },
+                  { label: '⚪ 已归档 (ARCHIVED)', value: 'ARCHIVED' },
+                ]}
+              />
+
+              <Button icon={<ReloadOutlined />} onClick={loadData}>
+                刷新
+              </Button>
+
+              <Button
+                onClick={() => {
+                  setKeyword('');
+                  setStatusFilter('ALL');
+                }}
+              >
+                重置
+              </Button>
+            </Space>
+          </Col>
+
+          <Col xs={24} lg={6} style={{ textAlign: 'right' }}>
+            <Button
+              type="primary"
+              icon={<PlusOutlined />}
+              onClick={() => handleOpenEditModal()}
+            >
+              + 新建项目
+            </Button>
+          </Col>
+        </Row>
+      </Card>
+
+      {/* 项目列表表格 */}
+      <Card
+        bordered={false}
+        style={{
+          borderRadius: 8,
+          boxShadow: '0 1px 2px 0 rgba(0, 0, 0, 0.03)',
+        }}
+      >
+        <Table<ProjectDto>
+          rowKey="id"
+          columns={columns}
+          dataSource={filteredProjects}
+          loading={loading}
+          pagination={{
+            pageSize: 10,
+            showTotal: (total) => `共 ${total} 个运营项目`,
+            showSizeChanger: true,
+          }}
+          scroll={{ x: 1100 }}
+        />
+      </Card>
+
+      {/* 新建/编辑项目模态框 */}
+      <Modal
+        title={editingProject ? '编辑运营项目' : '新建运营项目'}
+        open={editModalVisible}
+        onOk={handleSaveProject}
+        onCancel={() => setEditModalVisible(false)}
+        confirmLoading={submitting}
+        destroyOnClose
+        width={540}
+      >
+        <Form form={projectForm} layout="vertical" style={{ marginTop: 16 }}>
+          <Form.Item
+            name="name"
+            label="项目名称"
+            rules={[{ required: true, message: '请输入项目名称' }]}
+          >
+            <Input placeholder="例如: 深圳极速智慧车队" maxLength={30} />
+          </Form.Item>
+
+          <Form.Item
+            name="code"
+            label="项目唯一代码 (大写英文)"
+            tooltip="3~20 位大写英文字母、数字或下划线"
+            rules={[
+              { required: true, message: '请输入项目代号' },
+              {
+                validator: (_, value) => {
+                  if (!value || validateProjectCode(value)) {
+                    return Promise.resolve();
+                  }
+                  return Promise.reject(
+                    new Error('项目代号须为 3~20 位大写英文字母/数字/下划线')
