+import { CommandCode, CommandStatus, SecurityLevel } from '@car-control/contracts';
+
+export { CommandCode, CommandStatus, SecurityLevel };
+
+export interface CommandLifecycleStep {
+  stepIndex: number;
+  name: string;
+  title: string;
