+}
+
+export type LatencySlaLevel = 'NORMAL' | 'WARNING' | 'CRITICAL';
+
+export interface TimingSegment {
+  key: string;
+  label: string;
+  durationMs: number;
+  percentage: number;
+  color: string;
+}
+
+export interface StepTimingBreakdown {
+  totalDurationMs: number;
