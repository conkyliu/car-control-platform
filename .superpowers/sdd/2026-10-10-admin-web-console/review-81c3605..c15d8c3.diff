--- a/apps/web/src/api/command.ts
+++ b/apps/web/src/api/command.ts
@@ -13,6 +13,11 @@ import {
   generateDefaultCapabilities,
   SEED_WORKBENCH_VEHICLES,
 } from '../views/command/command-core.ts';
+import {
+  type CommandTraceDto,
