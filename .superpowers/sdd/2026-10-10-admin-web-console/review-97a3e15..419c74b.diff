@@ -0,0 +1,854 @@
+import React, { useState, useEffect, useMemo } from 'react';
+import {
+  Card,
+  Row,
+  Col,
+  Button,
+  Input,
+  Tag,
+  Space,
+  Radio,
+  Tree,
+  Modal,
+  Form,
+  Popconfirm,
+  message,
+  Typography,
+  Tooltip,
+  Alert,
+  Empty,
+  Badge,
+  Divider,
+} from 'antd';
+import type { TreeDataNode } from 'antd';
+import {
+  SafetyCertificateOutlined,
+  PlusOutlined,
+  EditOutlined,
+  DeleteOutlined,
+  SaveOutlined,
+  ReloadOutlined,
+  CheckSquareOutlined,
+  BorderOutlined,
+  FolderOpenOutlined,
+  FolderOutlined,
+  LockOutlined,
+  UserOutlined,
+  KeyOutlined,
+} from '@ant-design/icons';
+import { useAuthStore } from '../../store/useAuthStore.ts';
+import type { RoleDto, RoleDataScope, CreateRoleInput, UpdateRoleInput, PermissionTreeNode } from '../../api/role.ts';
+import {
+  fetchRolesApi,
+  createRoleApi,
+  updateRoleApi,
+  deleteRoleApi,
+  updateRolePermissionsApi,
+} from '../../api/role.ts';
+import { fetchUsersApi } from '../../api/user.ts';
+import {
+  calculateRoleStats,
+  aggregateRoleUserCounts,
+  canDeleteRole,
+  getDataScopeLabel,
+  getDataScopeColor,
+  DATA_SCOPE_OPTIONS,
+  flattenPermissionKeys,
+  getAllPermissionNodeKeys,
+  isSuperAdminRole,
+  SUPER_ADMIN_LOCKED_PERMISSIONS,
+  PERMISSION_TREE_DATA,
+  SEED_ROLES,
+  SEED_USERS,
+  isApiError,
+} from './rbac-core.ts';
+
+const { Title, Text, Paragraph } = Typography;
+const { TextArea } = Input;
+
+export const RolePermissionView: React.FC = () => {
+  const [loading, setLoading] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [roles, setRoles] = useState<RoleDto[]>([]);
+  const [selectedRoleId, setSelectedRoleId] = useState<string>('');
+
+  // 右侧配置区暂存编辑态
+  const [currentPermissions, setCurrentPermissions] = useState<string[]>([]);
+  const [currentDataScope, setCurrentDataScope] = useState<RoleDataScope>('ORG_AND_CHILDREN');
+
+  // 权限树展开 Keys
+  const [expandedKeys, setExpandedKeys] = useState<React.Key[]>(() =>
+    getAllPermissionNodeKeys(PERMISSION_TREE_DATA)
+  );
+
