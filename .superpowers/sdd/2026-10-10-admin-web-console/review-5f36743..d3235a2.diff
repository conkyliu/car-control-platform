+                              : c === 'timeoutMs'
+                              ? '超时阈值'
+                              : c === 'frequencyLimitSeconds'
+                              ? '冷却频控'
+                              : '参数约束'}
+                          </Tag>
+                        ))}
+                      </Space>
+                    ),
+                  },
+                ]}
+              />
+            )}
+          </div>
+        ) : (
+          <div style={{ textAlign: 'center', padding: '30px 0', color: 'rgba(0,0,0,0.45)' }}>
+            请选择需要对比的目标车型模板
+          </div>
+        )}
+      </Modal>
+    </div>
+  );
+};
