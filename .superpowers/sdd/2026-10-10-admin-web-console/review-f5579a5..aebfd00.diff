+import React from 'react';
+import { useAuthStore } from '../store/useAuthStore.ts';
+import { checkPermission } from '../layouts/admin-layout-core.ts';
+
+export interface PermissionGuardProps {
+  code: string;
+  children: React.ReactNode;
+  fallback?: React.ReactNode;
+}
+
+/**
+ * 细粒度操作按钮/组件级权限守卫
+ * 示例：<PermissionGuard code="device:write">{btn}</PermissionGuard>
+ */
+export const PermissionGuard: React.FC<PermissionGuardProps> = ({
+  code,
+  children,
+  fallback = null,
+}) => {
+  const hasPermission = useAuthStore((state) => state.hasPermission);
+  const permitted = checkPermission(hasPermission, code);
+
+  if (!permitted) {
+    return <>{fallback}</>;
+  }
+
+  return <>{children}</>;
+};
+
+export default PermissionGuard;
diff --git a/apps/web/src/router/routes.ts b/apps/web/src/router/routes.ts
index 1d1c033..cc01e1b 100644
--- a/apps/web/src/router/routes.ts
+++ b/apps/web/src/router/routes.ts
@@ -231,3 +231,67 @@ export function getRoutesByCategory(): Record<string, RouteMeta[]> {
 export function findRouteByPath(path: string): RouteMeta | undefined {
   return routes.find((route) => route.path === path);
 }
+
+/**
+ * 根据用户权限函数过滤可访问的菜单路由列表
+ */
+export function filterAccessibleRoutes(hasPermission: (code: string) => boolean): RouteMeta[] {
+  return routes
+    .filter((route) => {
+      if (route.hideInMenu) return false;
+      if (!route.permission) return true;
+      return hasPermission(route.permission);
+    })
+    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
+}
+
+/**
+ * 根据所属分组对有权限的菜单项进行分类归集，自动剔除无任何权限项的空分组
+ */
+export function getAccessibleRoutesByCategory(
+  hasPermission: (code: string) => boolean
+): Record<string, RouteMeta[]> {
+  const accessible = filterAccessibleRoutes(hasPermission);
+  const grouped: Record<string, RouteMeta[]> = {};
+
+  for (const item of accessible) {
+    const cat = item.category || '其他';
+    if (!grouped[cat]) {
+      grouped[cat] = [];
+    }
+    grouped[cat].push(item);
+  }
+
+  return grouped;
+}
+
+/**
+ * 根据当前激活路径计算层级面包屑列表
+ */
+export function computeBreadcrumbs(path: string): Array<{ title: string; path?: string }> {
+  if (path === RoutePath.DASHBOARD) {
+    return [
+      { title: '首页', path: RoutePath.DASHBOARD },
+      { title: '运营看板', path: RoutePath.DASHBOARD },
+    ];
+  }
+
+  const currentRoute = findRouteByPath(path);
+  if (!currentRoute) {
+    return [
+      { title: '首页', path: RoutePath.DASHBOARD },
+      { title: '未知页面' },
+    ];
+  }
+
+  const items: Array<{ title: string; path?: string }> = [
+    { title: '首页', path: RoutePath.DASHBOARD },
+  ];
+
+  if (currentRoute.category) {
+    items.push({ title: currentRoute.category });
+  }
+
+  items.push({ title: currentRoute.title, path: currentRoute.path });
+  return items;
+}
diff --git a/apps/web/src/store/useNavTabsStore.ts b/apps/web/src/store/useNavTabsStore.ts
new file mode 100644
index 0000000..3c42e66
--- /dev/null
+++ b/apps/web/src/store/useNavTabsStore.ts
@@ -0,0 +1,131 @@
+import { create } from 'zustand';
+import { RoutePath } from '../router/routes.ts';
+
+export interface NavTabItem {
+  key: string;
+  title: string;
+  closable: boolean;
+  icon?: string;
+}
+
+export interface NavTabsState {
+  activeKey: string;
+  tabs: NavTabItem[];
+  refreshCount: Record<string, number>;
+
+  openTab: (tab: { key: string; title: string; closable?: boolean; icon?: string }) => void;
+  switchTab: (key: string) => void;
+  closeTab: (key: string) => void;
+  closeOthers: (key: string) => void;
+  closeAll: () => void;
+  refreshTab: (key: string) => void;
+  resetTabs: () => void;
+}
+
+const DEFAULT_TAB: NavTabItem = {
+  key: RoutePath.DASHBOARD,
+  title: '运营看板',
+  closable: false,
+};
+
+export const useNavTabsStore = create<NavTabsState>((set, get) => ({
+  activeKey: DEFAULT_TAB.key,
+  tabs: [DEFAULT_TAB],
+  refreshCount: {},
+
+  openTab: (tab) => {
+    const { tabs } = get();
+    const existingIndex = tabs.findIndex((t) => t.key === tab.key);
+
+    if (existingIndex >= 0) {
+      set({ activeKey: tab.key });
+      return;
+    }
+
+    const newTabItem: NavTabItem = {
+      key: tab.key,
+      title: tab.title,
+      closable: tab.closable ?? (tab.key !== DEFAULT_TAB.key),
+      icon: tab.icon,
+    };
+
+    set({
+      tabs: [...tabs, newTabItem],
+      activeKey: tab.key,
+    });
+  },
+
+  switchTab: (key) => {
+    const { tabs } = get();
+    if (tabs.some((t) => t.key === key)) {
+      set({ activeKey: key });
+    }
+  },
+
+  closeTab: (key) => {
+    const { tabs, activeKey } = get();
+    const targetTab = tabs.find((t) => t.key === key);
+
+    // Non-closable tabs cannot be removed
+    if (!targetTab || targetTab.closable === false) {
+      return;
+    }
+
+    const targetIndex = tabs.findIndex((t) => t.key === key);
+    let nextActiveKey = activeKey;
+
+    if (activeKey === key) {
+      if (targetIndex > 0) {
+        nextActiveKey = tabs[targetIndex - 1]!.key;
+      } else if (tabs.length > 1) {
+        nextActiveKey = tabs[targetIndex + 1]!.key;
+      } else {
+        nextActiveKey = DEFAULT_TAB.key;
+      }
+    }
+
+    const filtered = tabs.filter((t) => t.key !== key);
+    set({
+      tabs: filtered,
+      activeKey: nextActiveKey,
+    });
+  },
+
+  closeOthers: (targetKey) => {
+    const { tabs } = get();
+    const filtered = tabs.filter((t) => t.closable === false || t.key === targetKey);
+
+    set({
+      tabs: filtered,
+      activeKey: targetKey,
+    });
+  },
+
+  closeAll: () => {
+    const { tabs } = get();
+    const unclosable = tabs.filter((t) => t.closable === false);
+    const fallbackTabs = unclosable.length > 0 ? unclosable : [DEFAULT_TAB];
+
+    set({
+      tabs: fallbackTabs,
+      activeKey: fallbackTabs[0]!.key,
+    });
+  },
+
+  refreshTab: (key) => {
+    set((state) => ({
+      refreshCount: {
+        ...state.refreshCount,
+        [key]: (state.refreshCount[key] ?? 0) + 1,
+      },
+    }));
+  },
+
+  resetTabs: () => {
+    set({
+      activeKey: DEFAULT_TAB.key,
+      tabs: [DEFAULT_TAB],
+      refreshCount: {},
+    });
+  },
+}));
