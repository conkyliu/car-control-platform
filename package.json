{
  "name": "car-control-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Car Control Platform Monorepo V2.0",
  "scripts": {
    "build": "pnpm -r --filter=!@car-control/mobile build",
    "test": "pnpm -r --filter=!@car-control/mobile test",
    "lint": "pnpm -r --filter=!@car-control/mobile lint",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
